{% assign locale = include.locale | default: site.locale %}

<nav class="nav__list">

  {% if page.sidebar.title %}
    <h3 class="nav__title" style="padding-left: 0;">
      {{ page.sidebar.title }}
    </h3>
  {% endif %}

  <input id="ac-toc" name="accordion-toc" type="checkbox" />

  <label for="ac-toc">
    {{ site.data.ui-text[locale].menu_label | default: "Toggle Menu" }}
  </label>

  <ul class="nav__items">

    {% for navname in include.nav %}
      {% assign navigation = site.data.navigation[navname] %}

      {% for nav in navigation %}

        {% assign parent_count = 0 %}

        {% if nav.children %}
          {% for child in nav.children %}

            {% if child.category %}
              {% assign child_posts = site.categories[child.category] %}

              {% if child_posts %}
                {% assign parent_count = parent_count | plus: child_posts.size %}
              {% endif %}
            {% endif %}

          {% endfor %}
        {% endif %}

        <li>

          {% if nav.url %}
            <a href="{{ nav.url | relative_url }}">
              <span class="nav__sub-title">

                {{ nav.title }}

                {% if nav.children %}
                  <span class="sidebar-count">
                    ({{ parent_count }})
                  </span>
                {% endif %}

              </span>
            </a>

          {% else %}

            <span class="nav__sub-title">

              {{ nav.title }}

              {% if nav.children %}
                <span class="sidebar-count">
                  ({{ parent_count }})
                </span>
              {% endif %}

            </span>

          {% endif %}


          {% if nav.children != null %}

            <ul>

              {% for child in nav.children %}

                {% assign child_count = 0 %}

                {% if child.category %}
                  {% assign child_posts = site.categories[child.category] %}

                  {% if child_posts %}
                    {% assign child_count = child_posts.size %}
                  {% endif %}
                {% endif %}

                <li>

                  <a
                    href="{{ child.url | relative_url }}"
                    {% if child.url == page.url %}
                      class="active"
                    {% endif %}
                  >

                    {{ child.title }}

                    {% if child.category %}
                      <span class="sidebar-count">
                        ({{ child_count }})
                      </span>
                    {% endif %}

                  </a>

                </li>

              {% endfor %}

            </ul>

          {% endif %}

        </li>

      {% endfor %}
    {% endfor %}

  </ul>

</nav>